# Copy this file to `.env` in this folder for local development with `npm run dev:netlify`.
# Never commit `.env` (it is gitignored).
#
# Production / preview: set the same variable in the Netlify UI:
# Site configuration → Environment variables → Add variable
#
# Used by Netlify Functions: Whisper (audio) + chat (field extraction).
OPENAI_API_KEY=
